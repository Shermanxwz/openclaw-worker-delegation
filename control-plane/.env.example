# Production control plane. Keep the Node service on loopback; publish only the
# reverse proxy on 80/443.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATA_DIR=/var/lib/openclaw-delegation
PUBLIC_ORIGIN=https://<PUBLIC_IP_OR_HOSTNAME>
COOKIE_SECURE=true
TRUST_PROXY=true

# Generate with:
#   CONTROL_PASSWORD_INPUT='a unique passphrase of 14+ characters' npm run hash-password
CONTROL_PASSWORD_HASH=scrypt$2$replace-with-generated-value

# Optional but strongly recommended for an Internet-facing control panel:
#   npm run generate-totp-secret
CONTROL_TOTP_SECRET=

# Generate with: npm run generate-token
# The controller reads AGENT_INGEST_TOKEN. Configure the same value as
# OCWD_AGENT_TOKEN in the OpenClaw Gateway service environment. Never place it
# in prompts, skills, workspaces, browser storage, or generic shell profiles.
AGENT_INGEST_TOKEN=replace-with-at-least-32-random-characters

# Agent IDs must match the actual OpenClaw agent entries.
MAIN_AGENT_IDS=main
WORKER_AGENT_IDS=body-worker
VERIFIER_AGENT_IDS=verifier

DEFAULT_MODE=auto
SESSION_TTL_MINUTES=480
MAIN_MODE_DEFAULT_TTL_MINUTES=30
MAIN_MODE_MAX_TTL_MINUTES=120
# Persistent Main remains active until an operator switches back to Auto/Worker.
# It is disabled by default and requires ENABLE_MAIN_PERSISTENT + re-auth.
MAIN_ALLOW_PERSISTENT=false
TASK_OVERRIDE_DEFAULT_TTL_MINUTES=30
TASK_OVERRIDE_MAX_TTL_MINUTES=120

# Runtime/plugin proof. HARD requires a fresh heartbeat and real same-instance
# route + tool observations.
RUNTIME_STALE_SECONDS=90

# Durable route binding must outlive the longest standard Worker task plus
# control overhead. Default is 65 minutes.
ROUTE_DECISION_TTL_SECONDS=3900

# Durable Worker/Verifier task contracts. Values can LOWER the product ceilings
# but cannot raise quick above 600s or standard above 3600s.
WORKER_TASK_STANDARD_MAX_SECONDS=3600
WORKER_TASK_QUICK_MAX_SECONDS=600
# Heartbeat proves liveness; only meaningful progress renews the normal lease.
WORKER_TASK_LEASE_SECONDS=300
WORKER_TASK_GRACE_SECONDS=60
WORKER_HEARTBEAT_STALE_SECONDS=45
WORKER_MAX_RECORDS=2000

MAX_EVENTS=4000
MAX_SSE_CLIENTS=8
MAX_PASSWORD_CHECKS=2
AUDIT_ALLOWED_TOOLS=true

# Extra tool IDs are opt-in. Allowing exec for a verifier is not read-only.
WORKER_EXTRA_TOOLS=
VERIFIER_EXTRA_TOOLS=
