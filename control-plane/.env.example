# The controller binds to loopback by default. Put Caddy/Nginx in front of it.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data

# Public browser origin. Required for strict Origin checks in production.
PUBLIC_ORIGIN=https://claw.example.com
COOKIE_SECURE=true
SESSION_TTL_MINUTES=480

# Generate with: CONTROL_PASSWORD='choose-a-password' npm run hash-password
CONTROL_PASSWORD_HASH=scrypt$replace-with-generated-value

# Used by the OpenClaw runtime adapter for policy/event API calls.
AGENT_INGEST_TOKEN=replace-with-a-long-random-token

# Optional defaults.
DEFAULT_MODE=auto
MAIN_MODE_DEFAULT_TTL_MINUTES=30
MAIN_MODE_MAX_TTL_MINUTES=120
MAX_EVENTS=1000
