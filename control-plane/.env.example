# Production control plane. Keep the Node service on loopback; publish only the
# reverse proxy on 80/443.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATA_DIR=/var/lib/openclaw-delegation
PUBLIC_ORIGIN=https://<PUBLIC_IP_OR_HOSTNAME>
COOKIE_SECURE=true
TRUST_PROXY=true

# Generate with:
#   CONTROL_PASSWORD_INPUT='a unique passphrase of 14+ characters' npm run hash-password
CONTROL_PASSWORD_HASH=scrypt$2$replace-with-generated-value

# Optional but strongly recommended for an Internet-facing control panel:
#   npm run generate-totp-secret
# Add the Base32 value to an authenticator application manually.
CONTROL_TOTP_SECRET=

# Generate with: npm run generate-token
# The controller reads AGENT_INGEST_TOKEN. Configure the same value as
# OCWD_AGENT_TOKEN in the OpenClaw Gateway service environment. Do not put it in
# prompts, skills, logs, or browser storage.
AGENT_INGEST_TOKEN=replace-with-at-least-32-random-characters

# Agent IDs must match the actual agents.list entries in openclaw.json.
MAIN_AGENT_IDS=main
WORKER_AGENT_IDS=body-worker
VERIFIER_AGENT_IDS=verifier

DEFAULT_MODE=auto
SESSION_TTL_MINUTES=480
MAIN_MODE_DEFAULT_TTL_MINUTES=30
MAIN_MODE_MAX_TTL_MINUTES=120
# Persistent Main stays in effect until the operator manually switches back to
# Auto/Worker. Off by default. When off, ttlMinutes=0 for Main is rejected with
# 403 persistent_main_disabled even with the right confirmation token.
MAIN_ALLOW_PERSISTENT=false
TASK_OVERRIDE_DEFAULT_TTL_MINUTES=30
TASK_OVERRIDE_MAX_TTL_MINUTES=120
RUNTIME_STALE_SECONDS=90
ROUTE_DECISION_TTL_SECONDS=900
MAX_EVENTS=2000
MAX_SSE_CLIENTS=8
MAX_PASSWORD_CHECKS=2
AUDIT_ALLOWED_TOOLS=true

# Extra tool IDs are opt-in. Allowing exec for a verifier is not read-only.
WORKER_EXTRA_TOOLS=
VERIFIER_EXTRA_TOOLS=
