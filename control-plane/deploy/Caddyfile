# Optional hostname deployment. Replace the hostname.
claw.example.com {
    @agentEndpoints path /api/route /api/policy /api/tool-check /api/runtime-status
    respond @agentEndpoints 404

    @agentEventPost {
        path /api/events
        method POST
    }
    respond @agentEventPost 404

    reverse_proxy 127.0.0.1:8787
}
